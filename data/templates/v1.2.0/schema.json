    {
      "key": "listing_transaction_links",
      "sheet": "03_房源成交关联",
      "owner": "产品 A",
      "rowRule": "一行关联一个 listing_id 和一个 transaction_id；同一交易可关联多个挂牌，但必须逐条说明 exact_property 或 comparable。",
      "fields": [
        {
          "key": "link_id",
          "label": "关联 ID",
          "type": "text",
