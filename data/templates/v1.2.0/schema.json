{
  "version": "1.2.0",
  "purpose": "BHHS Demo 产品数据交付与开发接入模板",
  "emptyValue": "CSV 空单元格 / JSON null；不得用 0 代替未知",
  "multiValueDelimiter": "|",
  "dateFormat": "YYYY-MM-DD",
  "datetimeFormat": "ISO 8601 with timezone",
  "excelDataStartRow": 6,
  "excelKeyRow": 5,
  "tables": [
    {
      "key": "listing_snapshots",
      "sheet": "01_房源挂牌",
      "owner": "产品 A",
      "rowRule": "一行是一条挂牌在一个采集时刻的快照；同一挂牌更新另建 snapshot_id，listing_id 保持稳定。",
      "fields": [
        {
          "key": "snapshot_id",
          "label": "挂牌快照 ID",
          "type": "text",
          "required": "必填",
          "description": "本表唯一且稳定；不得因为改价格复用同一个快照 ID。",
          "example": "DEMO-LS-001",
          "options": []
        },
        {
          "key": "listing_id",
          "label": "挂牌 ID",
          "type": "text",
          "required": "必填",
          "description": "同一平台同一挂牌使用同一 ID；不同平台挂牌不要仅凭相似描述合并。",
          "example": "DEMO-L-001",
          "options": []
        },
        {
          "key": "property_id",
          "label": "内部房屋 ID",
          "type": "text",
          "required": "选填",
          "description": "只有可靠证据识别同一物理房屋时才跨记录共用；无法识别留空。",
          "example": "DEMO-P-001",
          "options": []
        },
        {
          "key": "title",
          "label": "房源标题",
          "type": "text",
          "required": "必填",
          "description": "可复用来源标题；不得加入未披露的地段、设施或景观承诺。",
          "example": "演示公寓 A",
          "options": []
        },
        {
          "key": "area_name",
          "label": "区域或社区",
          "type": "text",
          "required": "必填",
          "description": "沿用来源名称；不同来源别名由产品给映射，不自行视为同一区域。",
          "example": "DEMO-AREA",
          "options": []
        },
        {
          "key": "building_name",
          "label": "楼宇或项目名称",
          "type": "text",
          "required": "选填",
          "description": "来源中的楼宇/项目名称；同楼不等于同一套房。",
          "example": "DEMO-BUILDING",
          "options": []
        },
        {
          "key": "unit_ref",
          "label": "单元或房屋标识",
          "type": "text",
          "required": "选填",
          "description": "仅填来源可靠披露且可用于此 Demo 的单元标识；没有则留空。",
          "example": "DEMO-UNIT-01",
          "options": []
        },
        {
          "key": "property_type",
          "label": "物业类型",
          "type": "enum",
          "required": "必填",
          "description": "与现房/期房和挂牌状态分开。",
          "example": "apartment",
          "options": [
            "apartment",
            "villa",
            "townhouse",
            "penthouse",
            "land",
            "other",
            "unknown"
          ]
        },
        {
          "key": "bedrooms",
          "label": "卧室数",
          "type": "integer",
          "required": "选填",
          "description": "Studio 填 0；未披露留空；不要填“未知”到数值列。",
          "example": "2",
          "options": []
        },
        {
          "key": "area_value",
          "label": "面积数值",
          "type": "number",
          "required": "条件必填",
          "description": "如来源披露面积则填数值，同时填写单位和面积口径。",
          "example": "120",
          "options": []
        },
        {
          "key": "area_unit",
          "label": "面积单位",
          "type": "enum",
          "required": "条件必填",
          "description": "有面积数值必须填单位；开发端可换算但不能静默改变面积口径。",
          "example": "sqm",
          "options": [
            "sqm",
            "sqft"
          ]
        },
        {
          "key": "area_basis",
          "label": "面积口径",
          "type": "enum",
          "required": "条件必填",
          "description": "有面积数值必须给出口径；不明时填 unknown。",
          "example": "unknown",
          "options": [
            "internal",
            "gross",
            "built_up",
            "land",
            "unknown"
          ]
        },
        {
          "key": "market_segment",
          "label": "现房或期房",
          "type": "enum",
          "required": "必填",
          "description": "反映物业当前状态，与新挂牌/旧挂牌不同。",
          "example": "ready",
          "options": [
            "ready",
            "off_plan",
            "unknown"
          ]
        },
        {
          "key": "listing_status",
          "label": "挂牌状态",
          "type": "enum",
          "required": "必填",
          "description": "active 在售；withdrawn 下架；sold 仅有成交证据时使用；下架不能自动判为成交。",
          "example": "active",
          "options": [
            "active",
            "withdrawn",
            "sold",
            "unknown"
          ]
        },
        {
          "key": "asking_price",
          "label": "挂牌价格",
          "type": "number",
          "required": "条件必填",
          "description": "仅填当前挂牌价；未披露留空。租金不可作为出售价格填入本表。",
          "example": "2000000",
          "options": []
        },
        {
          "key": "currency",
          "label": "价格币种",
          "type": "enum",
          "required": "条件必填",
          "description": "有价格必填，首版按原始币种保留；跨币种比较需要另外提供汇率来源和日期。",
          "example": "AED",
          "options": [
            "AED",
            "USD",
            "EUR",
            "GBP",
            "other"
          ]
        },
        {
          "key": "listed_at",
          "label": "首次挂牌日期",
          "type": "date",
          "required": "选填",
          "description": "来源未披露则留空，不以首次抓取日期冒充。",
          "example": "2026-09-01",
          "options": []
        },
        {
          "key": "availability_date",
          "label": "可交付或入住日期",
          "type": "date",
          "required": "选填",
          "description": "仅填明确日期；仅有季度/年份时记录到备注，不补造月日。",
          "example": "2026-12-01",
          "options": []
        },
        {
          "key": "amenities",
          "label": "已披露设施与特征",
          "type": "multi_text",
          "required": "选填",
          "description": "多值用 | 分隔，例 pool|parking；客户要求的设施不能反向填成房源已具备。",
          "example": "pool|parking",
          "options": []
        },
        {
          "key": "evidence_excerpt",
          "label": "关键事实证据摘录",
          "type": "text",
          "required": "选填",
          "description": "支持价格、户型、状态等关键字段的简短原文；注明未覆盖字段。",
          "example": "演示格式说明，不是原文证据",
          "options": []
        },
        {
          "key": "data_kind",
          "label": "数据性质",
          "type": "enum",
          "required": "必填",
          "description": "真实公开、真实授权与演示数据必须区分；不能以公开可见替代使用许可。",
          "example": "demo",
          "options": [
            "real_public",
            "real_authorized",
            "demo"
          ]
        },
        {
          "key": "source_name",
          "label": "来源名称",
          "type": "text",
          "required": "必填",
          "description": "网站、登记机关或授权脱敏资料名称；演示数据填“演示样例”。",
          "example": "演示样例",
          "options": []
        },
        {
          "key": "source_ref",
          "label": "来源链接或资料编号",
          "type": "text",
          "required": "必填",
          "description": "公开数据填可追溯原文 URL；内部资料填脱敏文件编号，不填访问令牌或个人身份信息。",
          "example": "DEMO-SOURCE-001",
          "options": []
        },
        {
          "key": "source_date",
          "label": "来源发布日期",
          "type": "date",
          "required": "选填",
          "description": "仅填原文明确的完整日期；不把采集日期、登记日期或估计日期填在这里。",
          "example": "2026-09-03",
          "options": []
        },
        {
          "key": "captured_at",
          "label": "采集或整理时间",
          "type": "datetime",
          "required": "必填",
          "description": "实际采集/整理时间，采用 ISO 8601 且含时区。",
          "example": "2026-09-03T10:00:00+08:00",
          "options": []
        },
        {
          "key": "verification_status",
          "label": "核验状态",
          "type": "enum",
          "required": "必填",
          "description": "verified 表示产品已核验相应字段；source-backed 不自动意味着可用。",
          "example": "needs_review",
          "options": [
            "verified",
            "needs_review",
            "conflict"
          ]
        },
        {
          "key": "usage_status",
          "label": "使用许可状态",
          "type": "enum",
          "required": "必填",
          "description": "approved 表示已确认可用于本 Demo；pending 待确认；restricted 不可导入演示。",
          "example": "pending",
          "options": [
            "approved",
            "pending",
            "restricted"
          ]
        },
        {
          "key": "reviewed_by",
          "label": "核验人",
          "type": "text",
          "required": "条件必填",
          "description": "verification_status 为 verified 时填写实际核验人；不得默认已核验。",
          "example": "产品 A",
          "options": []
        },
        {
          "key": "notes",
          "label": "缺失与限制说明",
          "type": "text",
          "required": "选填",
          "description": "记录未披露字段、冲突、过期风险等；未知数值留空而不是填 0。",
          "example": "格式示例，非真实数据",
          "options": []
        }
      ]
    },
    {
      "key": "transactions",
      "sheet": "02_成交记录",
      "owner": "产品 A",
      "rowRule": "一行是一条来源中的交易记录；可比关联放到下一表，不能为多个关联重复创建同一交易。",
